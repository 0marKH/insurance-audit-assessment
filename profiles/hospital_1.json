              "Sunday"
            ],
            "public_holidays_excluded": false
          },
          "rule_scope": {
            "hospital_id": "hospital_1",
            "group_by": [
              "service_date"
            ]
          },
          "rule_order": {
            "stage": null,
            "after": [],
            "position": null
          },
          "interpretation": "Only Saturdays and Sundays are excluded; public holidays are not an additional exclusion.",
          "questions": [],
          "also_source": [
            "2.1"
          ]
        }
      ]
    },
    "2.3": {
      "section": "2",
      "text": "2.3 \"Unit\" means one billable unit of the Service on the unit basis stated for that Service in Section 4.",
