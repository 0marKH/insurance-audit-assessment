          "action": {
            "type": "set_facility_multiplier",
            "facility_name": "Main Campus",
            "facility_code": "F-MAIN",
            "multiplier": {
              "numerator": 1,
              "denominator": 1
            }
          },
          "rule_scope": {
            "hospital_id": "hospital_1",
            "group_by": [
