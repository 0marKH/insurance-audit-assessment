    "2.1": {
      "section": "2",
      "text": "2.1 \"Service Day\" means the calendar day recorded as the Service Date of the line item.",
      "rules": [
        {
          "rule_id": "H1-C2-1-1",
          "kind": "definition",
          "applies_to": {
            "entity": "service_date"
          },
          "condition": {
            "always": true
          },
          "action": {
            "type": "define_service_day",
            "value": "calendar_day_of_line_service_date"
          },
          "rule_scope": {
            "hospital_id": "hospital_1",
            "group_by": [
              "line_id"
            ]
          },
          "rule_order": {
            "stage": null,
            "after": [],
            "position": null
          },
          "interpretation": "Use the line service date as the service day, not the invoice date.",
          "questions": [],
          "also_source": []
        }
      ]
    },
    "2.2": {
      "section": "2",
      "text": "2.2 \"Business Day\" means any Service Day other than a Saturday or a Sunday.",
      "rules": [
        {
          "rule_id": "H1-C2-2-1",
          "kind": "definition",
          "applies_to": {
            "entity": "service_date"
          },
